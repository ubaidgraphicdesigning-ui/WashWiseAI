# Copy this file to secrets.toml and fill your real Supabase values.
# Recommended new Supabase key format: sb_secret_...
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_REPLACE_WITH_YOUR_SERVER_SECRET_KEY"

# One shared staff PIN. This is NOT a user login; the public dashboard opens without it.
# Staff pages (customer records, payments, orders, expenses) require this PIN.
ADMIN_PIN = "CHANGE-THIS-TO-A-LONG-PRIVATE-PIN"

# Optional generative AI. Local business analytics still work without Gemini.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

# Optional: pin this deployment to a specific business UUID after setup.
# BUSINESS_ID = ""
